{
  "name": "@lamplitisles/lamplit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-notices.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run test",
    "deploy": "pnpm run verify && wrangler deploy",
    "deploy:dry-run": "pnpm run verify && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.28",
    "linkedom": "^0.18.13",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "marked": "^18.0.11"
  }
}
